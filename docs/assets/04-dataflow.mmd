flowchart LR
    subgraph User
        U[用戶]
    end
    subgraph Pi["Pi 宿主"]
        E[pmmeeting extension<br/>commands/tool/events]
        S[skills loader]
    end
    subgraph Pkg["pmmeeting 套件（~/.pi/agent/git/…）"]
        SK[skills/pmmeeting/SKILL.md]
        UP[upstream/superpowers/skills/*（15，vendored）]
        NP[node_modules/@fission-ai/openspec<br/>pin 2.0.0]
        LOCK[superpowers.lock.json]
    end
    subgraph Proj["用戶 project"]
        OS[openspec/ 樹<br/>specs/ + changes/&lt;id&gt;/]
        ST[.pmmeeting/project.json<br/>changes/&lt;id&gt;/.pmmeeting.json]
        AG[.agents/skills/openspec-*<br/>（官方 init 產出）]
        MEM[AGENTS.md / memory]
    end

    U -->|/pmmeeting| E
    E -->|read 絕對路徑| SK
    SK -->|phase 指令：read 絕對路徑| UP
    E -->|spawn| NP
    NP -->|init/validate/instructions/archive| OS
    E -->|gate 通過才寫| ST
    S -->|自動發現| AG
    E -.->|retro/memory| MEM
    LOCK -.->|doctor 校驗| UP
